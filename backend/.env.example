# Google Maps (Geocoding + Directions APIs). Required for travel-time/geocoding
# features. Get one at https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# SAC.ch credentials (the user's own account). Used only to log in and read
# route data server-side; never exposed to the frontend. Optional — SAC
# sourcing is skipped (and logged) if unset.
SAC_USERNAME=
SAC_PASSWORD=

# gipfelbuch.ch credentials (the user's own account). Same handling as SAC.
GIPFELBUCH_USERNAME=
GIPFELBUCH_PASSWORD=

# How long a search result is cached, in seconds. Default 24h.
CACHE_TTL_SECONDS=86400
